      "source": [
        "## 3. PSO — Particle Swarm Optimization (la méthode \"existante\" comparée)\n",
        "\n",
        "Même espace de recherche, même fonction objectif, algorithme d'exploration différent :\n",
        "les particules se déplacent en fonction de leur meilleure position connue et de la\n",
        "meilleure position globale du groupe, au lieu de croisement/mutation génétique."
      ],
      "id": "x5zPLW23eYGY"
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "iSWpUbxaeYGZ",
        "outputId": "222fcfb6-a067-4599-f638-2ca9d7ddf766"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "PSO en cours (2-4 min, comparable au GA)...\n",
            "PSO terminé en 40.7s — meilleure fitness : 2.461\n"
          ]
        }
      ],
      "source": [
        "import pyswarms as ps\n",
        "\n",
        "def pso_objective(swarm_params):\n",
        "    # pyswarms MINIMISE par défaut -> on inverse le signe de la fitness (qu'on veut maximiser)\n",
        "    return np.array([-fitness_from_params(p) for p in swarm_params])\n",
        "\n",
        "bounds_pso = (np.array(BOUNDS_LOW), np.array(BOUNDS_HIGH))\n",
        "options = {'c1': 1.5, 'c2': 1.5, 'w': 0.7}\n",
        "\n",
        "optimizer = ps.single.GlobalBestPSO(n_particles=20, dimensions=5, options=options, bounds=bounds_pso)\n",
        "\n",
        "print(\"PSO en cours (2-4 min, comparable au GA)...\")\n",
        "t0 = time.time()\n",
        "best_cost, best_pos = optimizer.optimize(pso_objective, iters=15, verbose=False)\n",
        "pso_time = time.time() - t0\n",
        "pso_best_fitness = -best_cost\n",
        "pso_convergence = [-c for c in optimizer.cost_history]\n",
        "print(f\"PSO terminé en {pso_time:.1f}s — meilleure fitness : {pso_best_fitness:.3f}\")\n"
      ],
      "id": "iSWpUbxaeYGZ"
    },
