      "source": [
        "## 1. Fonction objectif partagée (identique pour GA et PSO)\n",
        "\n",
        "C'est le point clé de la comparaison : **le problème résolu est rigoureusement le même**,\n",
        "seul l'algorithme d'optimisation change."
      ],
      "id": "Dci5vEK_eYGV"
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "metadata": {
        "id": "cIde9WAieYGW"
      },
      "outputs": [],
      "source": [
        "W_RATIO, W_PRD = 1.0, 0.3\n",
        "GA_SAMPLE_SIZE = 20\n",
        "\n",
        "BOUNDS_LOW  = [50,   0.5, 0.5, 0.5, 0.01]\n",
        "BOUNDS_HIGH = [3000, 3.0, 3.0, 3.0, 2.0]\n",
        "\n",
        "def fitness_from_params(params):\n",
        "    size_th, e1, e2, e3, sim_th = params\n",
        "    kwargs = dict(size_threshold=size_th, entropy_threshold_low=e1,\n",
        "                  entropy_threshold_mid=e2, entropy_threshold_high=e3,\n",
        "                  similarity_threshold=sim_th)\n",
        "    mean_ratio, mean_prd = run_selector_over_channels(channel_data, kwargs, max_segments_per_channel=GA_SAMPLE_SIZE)\n",
        "    return W_RATIO * mean_ratio - W_PRD * mean_prd\n"
      ],
      "id": "cIde9WAieYGW"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "0A7OdjOLeYGX"
      },
      "source": [
        "## 2. Algorithme génétique (repris de 03, pour comparaison directe dans ce notebook)"
      ],
      "id": "0A7OdjOLeYGX"
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "J3ap8ktCeYGX",
        "outputId": "70f4f761-bd6a-426c-eecb-f4a412beecba"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "GA en cours (2-4 min)...\n",
            "GA terminé en 37.3s — meilleure fitness : 2.544\n"
          ]
        }
      ],
      "source": [
        "from deap import base, creator, tools, algorithms\n",
        "\n",
        "if 'FitnessMax' not in dir(creator):\n",
        "    creator.create('FitnessMax', base.Fitness, weights=(1.0,))\n",
        "    creator.create('Individual', list, fitness=creator.FitnessMax)\n",
        "\n",
        "def repair(ind):\n",
        "    for i in range(5):\n",
        "        ind[i] = max(BOUNDS_LOW[i], min(BOUNDS_HIGH[i], ind[i]))\n",
        "    return ind\n",
        "\n",
        "toolbox = base.Toolbox()\n",
        "toolbox.register('attr_gene', lambda i: random.uniform(BOUNDS_LOW[i], BOUNDS_HIGH[i]))\n",
        "toolbox.register('individual', lambda: creator.Individual([toolbox.attr_gene(i) for i in range(5)]))\n",
        "toolbox.register('population', tools.initRepeat, list, toolbox.individual)\n",
        "toolbox.register('evaluate', lambda ind: (fitness_from_params(ind),))\n",
        "toolbox.register('mate', tools.cxBlend, alpha=0.5)\n",
        "toolbox.register('mutate', tools.mutGaussian, mu=0, sigma=0.3, indpb=0.3)\n",
        "toolbox.register('select', tools.selTournament, tournsize=3)\n",
        "toolbox.decorate('mate', lambda f: (lambda *a,**k: [repair(c) for c in f(*a,**k)]))\n",
        "toolbox.decorate('mutate', lambda f: (lambda *a,**k: [repair(c) for c in f(*a,**k)]))\n",
        "\n",
        "pop = toolbox.population(n=20)\n",
        "hof = tools.HallOfFame(1)\n",
        "stats = tools.Statistics(lambda ind: ind.fitness.values[0])\n",
        "stats.register('max', np.max)\n",
        "\n",
        "print(\"GA en cours (2-4 min)...\")\n",
        "t0 = time.time()\n",
        "pop, logbook_ga = algorithms.eaSimple(pop, toolbox, cxpb=0.6, mutpb=0.3, ngen=15, stats=stats, halloffame=hof, verbose=False)\n",
        "ga_time = time.time() - t0\n",
        "ga_best_fitness = hof[0].fitness.values[0]\n",
        "ga_convergence = logbook_ga.select('max')\n",
        "print(f\"GA terminé en {ga_time:.1f}s — meilleure fitness : {ga_best_fitness:.3f}\")\n"
      ],
      "id": "J3ap8ktCeYGX"
    },
